# Local-only server. No client secret is needed for public-client device sign-in.
PORT=3600
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Delegated scopes must also be configured and consented in the app registration.
GRAPH_SCOPES=User.Read,User.Read.All,Application.Read.All,GroupMember.Read.All,AuditLog.Read.All,Policy.Read.All,RoleManagement.Read.Directory,DeviceManagementManagedDevices.Read.All,ThreatHunting.Read.All,Device.Read.All,Organization.Read.All,DeviceManagementConfiguration.Read.All,DeviceManagementServiceConfig.Read.All
# Preview APIs are disabled by default. Enable for workload/noninteractive sign-ins.
ENABLE_GRAPH_BETA=false
# Stop long queries at this many pages; the UI explicitly reports truncation.
MAX_PAGES=10
# Optional: comma-separated workspace GUIDs, maximum 5 per investigation.
LOG_ANALYTICS_WORKSPACE_IDS=
# Map a service-principal object ID to instrumented AppRoleName values.
# This is an operator-provided telemetry relationship, not authentication proof.
TELEMETRY_ENTITY_ROLES={}

# Personal Microsoft account sign-in removed 2026-10-18 (Aaron). To restore, add PERSONAL_CLIENT_ID=<app id> back
# and the personal sign-in button (see .backups/*.pre-ui2-20261018).
# Enable only with an organizational registration supporting multiple organizations.
ALLOW_MULTI_TENANT=false
# Add Organization.Read.All or LicenseAssignment.Read.All to GRAPH_SCOPES for tenant SKU inventory.

# Confidential sign-in (authorization code + PKCE + certificate). No client secret is supported.
# Upload only the PUBLIC certificate to the app registration. Keep the private key PEM outside this folder.
ENTRA_CERT_THUMBPRINT=
ENTRA_CERT_PRIVATE_KEY_PATH=
# auto = enforce Entity 360 app roles whenever confidential sign-in is configured; true/false to force.
ENTITY360_REQUIRE_APP_ROLES=auto

# Preferred: the certificate key stays in Azure Key Vault and the vault signs the sign-in assertion.
# Identifiers only (not secrets). ENTRA_CERT_THUMBPRINT is still required; ENTRA_CERT_PRIVATE_KEY_PATH is not.
# The signed-in Azure person needs the Key Vault Crypto User role on the vault (az login first).
ENTRA_KEYVAULT_URI=
ENTRA_KEYVAULT_CERT_NAME=

# Hosted (Azure Container Apps) only - set by Deploy-E360ContainerApp.ps1. Leave empty for local use.
# PUBLIC_BASE_URL=https://<app>.<env>.westus3.azurecontainerapps.io  (trust proxy, Secure cookie, redirect URI = <base>/auth/callback)
# HOST=0.0.0.0   (container only; default 127.0.0.1)
# ENTRA_REDIRECT_URI= (optional override)
# Key Vault token: managed identity when IDENTITY_ENDPOINT/IDENTITY_HEADER exist (platform-injected), otherwise az login.
